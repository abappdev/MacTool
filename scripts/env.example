# Shared across your apps — add to ~/.zshrc (no secrets here).
# Notary passwords live in Keychain under profile "MacTool" (see docs/release.md).

export APPLE_TEAM_ID="YOUR_TEAM_ID"
export APPLE_SIGN_IDENTITY="Developer ID Application: Your Name (YOUR_TEAM_ID)"

# Optional per-release (MacTool only):
# export MACTOOL_VERSION="1.0.1"
# export MACTOOL_BUILD="1"
