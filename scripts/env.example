# Copy into ~/.zshrc / ~/.bashrc (or `source` a private file). Do not commit secrets.
#
# List signing identities:
#   security find-identity -v -p codesigning
#
# Store notarization profile once (password stays in Keychain, not in bashrc):
#   xcrun notarytool store-credentials "$MACTOOL_NOTARY_PROFILE" \
#     --apple-id "$MACTOOL_APPLE_ID" \
#     --team-id "$MACTOOL_TEAM_ID" \
#     --password "<app-specific-password-from-appleid.apple.com>"

export MACTOOL_TEAM_ID="YOUR_TEAM_ID"
export MACTOOL_SIGN_IDENTITY="Developer ID Application: Your Name (YOUR_TEAM_ID)"
export MACTOOL_NOTARY_PROFILE="MacTool"
# Optional:
# export MACTOOL_APPLE_ID="you@example.com"
# export MACTOOL_VERSION="1.0.1"
# export MACTOOL_BUILD="1"
